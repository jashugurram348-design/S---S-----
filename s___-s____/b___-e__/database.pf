
import os
from pathlib import Path
from flask_sqlalchemy import SQLAlchemy
from sqlalchemy import inspect, text
from sqlalchemy.exc import SQLAlchemyError

db = SQLAlchemy()


def init_db(app):
    """Configure the database and initialize SQLAlchemy."""
    base_dir = Path(__file__).resolve().parent

    database_url = os.getenv(
        "DATABASE_URL",
        f"sqlite:///{base_dir / 'signspeak.db'}"
    )

    app.config.setdefault("SQLALCHEMY_DATABASE_URI", database_url)
    app.config.setdefault("SQLALCHEMY_TRACK_MODIFICATIONS", False)

    # SQLite connection settings
    if database_url.startswith("sqlite"):
        app.config.setdefault(
            "SQLALCHEMY_ENGINE_OPTIONS",
            {"connect_args": {"check_same_thread": False}}
        )

    db.init_app(app)


def create_tables(app):
    """Create database tables defined by your SQLAlchemy models."""
    with app.app_context():
        # Import models so SQLAlchemy knows about them.
        import models  # noqa: F401

        db.create_all()


def check_db_connection(app):
    """Check whether the configured database is reachable."""
    with app.app_context():
        try:
            with db.engine.connect() as connection:
                connection.execute(text("SELECT 1"))

            return {
                "success": True,
                "message": "Database connection successful."
            }

        except SQLAlchemyError:
            return {
                "success": False,
                "message": "Database connection failed."
            }


def get_table_names(app):
    """Return the names of tables currently in the database."""
    with app.app_context():
        inspector = inspect(db.engine)
        return inspector.get_table_names()
